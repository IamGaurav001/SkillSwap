# Postgres connection string (Neon, Supabase, Railway, RDS, ...).
# REQUIRED on serverless hosts such as Vercel, where the filesystem is not shared
# between requests. Leave unset for local development or a single-instance host:
# the app then falls back to a file-backed store at .data/skillswap.json.
DATABASE_URL=

# Set to "true" only if your Postgres host needs TLS without a verified CA chain
# (Supabase pooler and some managed hosts). Defaults to true when DATABASE_URL
# is not a localhost address.
PGSSL_NO_VERIFY=
